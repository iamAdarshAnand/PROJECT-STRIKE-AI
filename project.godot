config_version=5

[application]
config/name="Project Strike AI"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
move_forward={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":87}]}
move_back={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":83}]}
move_left={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":65}]}
move_right={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":68}]}
shoot={"deadzone":0.2,"events":[{"type":"InputEventMouseButton","button_index":1}]}
reload={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":82}]}
